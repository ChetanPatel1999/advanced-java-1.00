<web-app>
    
    <welcome-file-list>
        <welcome-file>home.html</welcome-file>
        <welcome-file>index.html</welcome-file>
        <welcome-file>index.jsp</welcome-file>
    </welcome-file-list>
    
    <servlet>
        <servlet-name>stdinfo</servlet-name>
        <servlet-class>pkg.StudentInfo</servlet-class>
    </servlet>
    
    <servlet>
        <servlet-name>stdresult</servlet-name>
        <servlet-class>pkg.StudentResult</servlet-class>
    </servlet>
    
    
    <servlet-mapping>
        <servlet-name>stdinfo</servlet-name>
        <url-pattern>/sinfo</url-pattern>
    </servlet-mapping>
    
    <servlet-mapping>
        <servlet-name>stdresult</servlet-name>
        <url-pattern>/sresult</url-pattern>
    </servlet-mapping>
    
</web-app>
